# GEMINI_API_KEY: Required for Study Cloud AI doubt solving and AI Test generation.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public base URL of the Study Cloud web app (used for Stripe Checkout return URLs & links).
APP_URL="http://localhost:3000"

# STRIPE_SECRET_KEY: Required for real paid course checkout & payment verification (get from Stripe Dashboard).
# Leave empty if only offering free courses until Stripe is configured.
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Optional Stripe webhook signing secret for asynchronous payment events.
STRIPE_WEBHOOK_SECRET=""

# Optional server-side direct PenPencil backup token for extended batch playback access:
PW_ACCESS_TOKEN=""
