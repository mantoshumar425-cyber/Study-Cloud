{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|assets/|robots\\.txt$|sitemap\\.xml$|manifest\\.webmanifest$|sw\\.js$|workbox-|.*\\.(?:png|jpg|jpeg|svg|ico|webp|woff2?|css|js|json|xml|txt)$).*)",
      "destination": "/index.html"
    }
  ]
}
